+ * that @p may use (p->cpus_ptr) and that are active (cpu_active_mask);
+ * see for_each_cpu_and(). Break ties in favour of @cpu. If @p is still
+ * queued on its current CPU (the WF_EXEC case), don't count its own weight
+ * against that CPU.
+ *
+ * Only p->pi_lock is held, so read other CPUs' totals with READ_ONCE()
+ * and never take their rq locks here. If no CPU qualifies, return @cpu
+ * and the core will pick a fallback.
+ */
+static int select_task_rq_wrr(struct task_struct *p, int cpu, int flags)
+{
+	return cpu;
+}
