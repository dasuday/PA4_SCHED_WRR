+/* ------------------------------------------------------------------------
+ * TODO(WRR Part C): system calls
+ *
+ *   long sched_setweight(pid_t pid, int weight);   x86_64 / arm64: 462
+ *   long sched_getweight(pid_t pid);               x86_64 / arm64: 463
+ *
+ * pid 0 means the calling thread. The syscall tables already point at these
+ * two functions; you only write the bodies. See the README for the full
+ * specification. In short:
+ *
+ * sched_getweight(pid)
+ *   returns the weight of @pid;
+ *   -EINVAL if pid < 0 or the task's policy is not SCHED_WRR;
+ *   -ESRCH  if there is no such task.
+ *
+ * sched_setweight(pid, weight)
+ *   sets the weight of @pid and returns 0;
+ *   -EINVAL if pid < 0, weight is outside WRR_MIN_WEIGHT..WRR_MAX_WEIGHT,
+ *           or the task's policy is not SCHED_WRR;
+ *   -ESRCH  if there is no such task;
+ *   -EPERM  if the caller lacks CAP_SYS_NICE and either does not own the
+ *           task (its euid matches neither the task's uid nor its euid) or
+ *           is trying to raise the weight. Lowering your own task's weight
+ *           is always allowed.
+ *   If the task is queued, rq->wrr.total_weight must change with it. The
+ *   new weight applies from the task's next turn: if the rest of the current
+ *   turn is longer than a full slice at the new weight, cut it to that.
+ *
+ * Hints:
+ *   - Look the task up under rcu_read_lock() with find_task_by_vpid() and
+ *     pin it with get_task_struct() / put_task_struct().
+ *   - task_rq_lock(p, &rf) / task_rq_unlock(rq, p, &rf) take p->pi_lock and
+ *     the task's rq->lock, so neither its policy nor its queue can change
+ *     while you hold them. Check the policy *under* that lock.
+ *   - Credentials: current_cred(), __task_cred(p) (under RCU), uid_eq(),
+ *     capable(CAP_SYS_NICE). Finish the permission check with
+ *     security_task_setscheduler(p) and return its error, if any.
+ *   - Check permissions before taking task_rq_lock(): capable() and the LSM
+ *     hook are not safe to call with a spinlock held and interrupts off.
+ */
+
+SYSCALL_DEFINE2(sched_setweight, pid_t, pid, int, weight)
+{
+	return -ENOSYS;
+}
+
+SYSCALL_DEFINE1(sched_getweight, pid_t, pid)
+{
+	return -ENOSYS;
+}
